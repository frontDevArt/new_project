# Скопировать в .env и заполнить. .env никогда не коммитится.
APP_ENV=dev

# --- Storage: Google Drive (storage.kind=gdrive) ---
# ID папки в Drive, где лежит файл базы
GDRIVE_FOLDER=
# Путь к JSON-ключу сервисного аккаунта Google (относительно корня проекта)
GDRIVE_CREDENTIALS_FILE=

# Локальному хранилищу (storage.kind=local) переменных не нужно:
# папка задаётся ключом storage.directory в config/<env>.yaml.

# --- Источник заявок (requests.kind=gsheet) ---
# ID Google-таблицы с заявками покупателей
REQUESTS_SHEET=
# Ключ сервисного аккаунта для таблицы — тот же GDRIVE_CREDENTIALS_FILE выше:
# отдельной переменной нет, аккаунт один. Таблицу нужно расшарить на его адрес.

# Источнику requests.kind=csv переменных не нужно: путь задаётся ключом
# requests.path в config/<env>.yaml.

# --- Уведомления (M3) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
